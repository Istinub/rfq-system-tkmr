generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
}

model RFQ {
  id                 String                @id @default(cuid())
  company            String
  contactName        String
  contactEmail       String
  contactPhone       String?
  createdAt          DateTime              @default(now())
  rfqNo              Int                   @unique @default(autoincrement())
  publicId           String?               @unique
  submittedByTokenId String?
  submittedByType    SubmittedByType       @default(ADMIN)
  attachments        Attachment[]
  quotations         Quotation[]
  submittedByToken   SubmissionToken?      @relation(fields: [submittedByTokenId], references: [id])
  items              RFQItem[]
  secureLinks        SecureLink[]
  accessLogs         SecureLinkAccessLog[]
}

model RFQItem {
  id       String  @id @default(cuid())
  rfqId    String
  name     String
  quantity Int
  details  String?
  rfq      RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
}

model Attachment {
  id          String  @id @default(cuid())
  rfqId       String
  fileName    String
  fileUrl     String
  fileSize    Int?
  driveFileId String?
  rfq         RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
}

model Quotation {
  id             String      @id @default(cuid())
  rfqId          String
  vendorName     String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  currency       String      @default("USD")
  notes          String?
  adjustments    Json?
  quotationLink  String
  driveFileId    String?
  driveFolderId  String?
  method         QuoteMethod @default(FORM)
  status         QuotationStatus @default(RECEIVED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  lines QuotationLine[]

  @@index([rfqId])
}


model QuotationLine {
  id           String   @id @default(cuid())
  quotationId  String
  name         String
  quantity     Int
  unitPrice    Float
  lineTotal    Float
  details      String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}



model SecureLink {
  id            String                @id @default(cuid())
  token         String                @unique
  rfqId         String
  createdAt     DateTime              @default(now())
  expiresAt     DateTime
  firstAccessAt DateTime?
  oneTime       Boolean               @default(false)
  accessCount   Int                   @default(0)
  lastAccessIP  String?
  disabled      Boolean               @default(false)
  rfq           RFQ                   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  logs          SecureLinkAccessLog[]
}

model SecureLinkAccessLog {
  id           String       @id @default(cuid())
  secureLinkId String?
  rfqId        String?
  token        String
  result       AccessResult
  ip           String?
  userAgent    String?
  createdAt    DateTime     @default(now())
  rfq          RFQ?         @relation(fields: [rfqId], references: [id])
  secureLink   SecureLink?  @relation(fields: [secureLinkId], references: [id])
}

model AdminSetting {
  id                 String   @id @default("default")
  tokenExpiryDays    Int      @default(7)
  oneTimeAccess      Boolean  @default(false)
  rateLimitPerMinute Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SubmissionToken {
  id        String    @id @default(cuid())
  label     String?
  tokenHash String    @unique
  expiresAt DateTime?
  maxUses   Int?
  uses      Int       @default(0)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  rfqs      RFQ[]
}

enum AccessResult {
  success
  expired
  disabled
  invalid
}

enum SubmittedByType {
  ADMIN
  TOKEN
}

enum QuoteMethod {
  FORM
}

enum QuotationStatus {
  RECEIVED
  REVISED
  APPROVED
  REJECTED
  CUSTOMER_ACCEPTED
}
