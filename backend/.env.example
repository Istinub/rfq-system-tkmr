# Backend environment configuration
# Copy this file to `.env` when running locally. Render dashboard variables will override these.

NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-frontend-domain.onrender.com
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=https://your-frontend-domain.onrender.com
ADMIN_API_KEY=
# Optional: separate token for public intake endpoint
INTAKE_TOKEN=
# Minutes before secure links expire (7 days = 10080 minutes)
SECURE_LINK_TTL_MINUTES=10080

# Google Drive API configuration
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=
# Parent folder for quotation PDFs ("Quotations" folder)
DRIVE_QUOTATIONS_FOLDER_ID=
# Set to "true" to make uploaded Drive files publicly viewable (anyone-with-link)
DRIVE_PUBLIC_FILES=true
